#!/usr/bin/env bash
# metafactory confidentiality pre-push hook (design doc §4 L5).
#
# Scans the OUTGOING commit range(s) for each ref being pushed and blocks the
# push on any BLOCK finding. This is the stale-clone re-leak control: a clone
# on pre-remediation history that tries to push scrubbed content out is stopped
# here. Gates on the ACTUAL push-remote URL ($2), not remote.origin.url.
#
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
# args:        $1 = remote name   $2 = remote URL
#
# Bypass: CONFIDENTIALITY_SKIP=1 git push ...   or   git push --no-verify
set -uo pipefail

HOOK_NAME="pre-push"
REMOTE_NAME="${1:-origin}"
REMOTE_URL="${2:-}"

# --- chain to a repo-local hook first ---------------------------------------
REPO_GIT_DIR="$(git rev-parse --git-dir 2>/dev/null || echo .git)"
LOCAL_HOOK="$REPO_GIT_DIR/hooks/$HOOK_NAME"
if [ -x "$LOCAL_HOOK" ] && [ "$(cd "$(dirname "$LOCAL_HOOK")" && pwd)/$HOOK_NAME" != "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")" ]; then
  # Re-feed stdin to the chained hook.
  STDIN_SAVED="$(cat)"
  printf '%s' "$STDIN_SAVED" | "$LOCAL_HOOK" "$@" || exit $?
else
  STDIN_SAVED="$(cat)"
fi

if [ "${CONFIDENTIALITY_SKIP:-0}" = "1" ]; then
  echo "confidentiality-scan: SKIPPED via CONFIDENTIALITY_SKIP=1 (skip usage is tracked in retro)" >&2
  exit 0
fi

# --- visibility gate: scan unless the push-remote is explicitly private ------
# Fail TOWARD scanning — only an explicit private-remote regex exempts a push.
if [ -n "${MF_PRIVATE_REMOTE_RE:-}" ] && printf '%s' "$REMOTE_URL" | grep -qE "$MF_PRIVATE_REMOTE_RE"; then
  echo "confidentiality-scan: pre-push SKIPPED — remote '$REMOTE_URL' matches MF_PRIVATE_REMOTE_RE (private)" >&2
  exit 0
fi

# --- resolve the engine ------------------------------------------------------
MF_SCAN_ENGINE_DEFAULT="__ENGINE_PATH__"
ENGINE="${MF_SCAN_ENGINE:-$MF_SCAN_ENGINE_DEFAULT}"
if [ -z "$ENGINE" ] || [ ! -f "$ENGINE" ]; then
  ENGINE="$HOME/.config/metafactory/pkg/repos/metafactory-actions/scan/confidentiality-scan.ts"
fi
if [ ! -f "$ENGINE" ]; then
  echo "confidentiality-scan: engine not found ($ENGINE). Set MF_SCAN_ENGINE or run install-hooks. FAILING CLOSED." >&2
  exit 1
fi

ZERO="0000000000000000000000000000000000000000"
EMPTY_TREE="$(git hash-object -t tree /dev/null 2>/dev/null || echo '')"
MAX_RANGE_COMMITS="${MF_MAX_RANGE_COMMITS:-2000}"
FAILED=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue           # branch deletion — nothing to scan

  if printf '%s' "$remote_sha" | grep -qE '^0+$'; then
    # New ref on the remote — bound the scan at the merge-base with the tracked
    # default branch, else the repo root commit.
    base="$(git merge-base "$local_sha" "$REMOTE_NAME/HEAD" 2>/dev/null || true)"
    [ -z "$base" ] && base="$(git rev-list --max-parents=0 "$local_sha" 2>/dev/null | tail -1)"
    range="${base:+$base..}$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  # Perf cap: a 91-tag / huge-range push must not hang the hook.
  n_commits="$(git rev-list --count "$range" 2>/dev/null || echo 0)"
  if [ "$n_commits" -gt "$MAX_RANGE_COMMITS" ]; then
    echo "confidentiality-scan: range $range has $n_commits commits (> $MAX_RANGE_COMMITS) — scanning tip diff only (perf cap)" >&2
    range="${local_sha}~1..${local_sha}"
  fi

  bun "$ENGINE" diff --range "$range" || FAILED=1
done <<EOF
$STDIN_SAVED
EOF

exit "$FAILED"
